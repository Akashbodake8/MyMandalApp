rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-mandal isolation
    match /mandals/{mandalId}/{document=**} {
      // Treasurer authentication: Treasurer's UID must match the Mandal ID
      // This assumes a 1:1 mapping for the basic version.
      allow read, write: if request.auth != null && request.auth.uid == mandalId;
    }

    // Public profile (optional read-only access for members in future)
    match /mandals/{mandalId}/profile {
       allow read: if true;
    }
  }
}
