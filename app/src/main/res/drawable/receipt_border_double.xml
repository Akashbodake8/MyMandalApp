<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.2pt" android:color="#000000" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Inner Border (with gap) -->
    <item android:top="4pt" android:bottom="4pt" android:left="4pt" android:right="4pt">
        <shape android:shape="rectangle">
            <stroke android:width="0.6pt" android:color="#000000" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
